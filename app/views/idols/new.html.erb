<h3>あなたにおすすめの女性アイドルグループ診断</h3>

<%= form_for(@idol, class: 'form-horizontal', role: 'form') do |f| %>
  <div class="idol-container">

  <!-- Q1 -->
  <div class="question-block">
    <p class="question-title">Q1. あなたの性格に近いのはどれ？</p>

    <div class="options-grid">
      <label class="option">
        <%= f.radio_button :question1, "1" %>
        <span>まっすぐで誠実</span>
      </label>

      <label class="option">
        <%= f.radio_button :question1, "2" %>
        <span>表現力が豊か</span>
      </label>

      <label class="option">
        <%= f.radio_button :question1, "3" %>
        <span>独自の世界観</span>
      </label>
    </div>
  </div>

  <!-- Q2 -->
  <div class="question-block">
    <p class="question-title">Q2. 好きな雰囲気に近いのはどれ？</p>

    <div class="options-grid">
      <label class="option">
        <%= f.radio_button :question2, "1" %>
        <span>落ち着いていてシンプル</span>
      </label>

      <label class="option">
        <%= f.radio_button :question2, "2" %>
        <span>華やかでかわいい</span>
      </label>

      <label class="option">
        <%= f.radio_button :question2, "3" %>
        <span>独創的でユニーク</span>
      </label>
    </div>
  </div>

  <!-- Q3 -->
  <div class="question-block">
    <p class="question-title">Q3. あなたが憧れるタイプは？</p>

    <div class="options-grid">
      <label class="option">
        <%= f.radio_button :question3, "1" %>
        <span>真面目で丁寧に頑張る人</span>
      </label>

      <label class="option">
        <%= f.radio_button :question3, "2" %>
        <span>かわいくてみんなに愛される人</span>
      </label>

      <label class="option">
        <%= f.radio_button :question3, "3" %>
        <span>個性の強いこだわり派</span>
      </label>
    </div>
  </div>

  <!-- 診断ボタン -->
  <div class="sindanbotan">
    <%= f.submit "診断する" %>
  </div>

<% end %>
